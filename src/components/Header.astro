---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="container">
    <div class="d-md-flex justify-content-around align-items-center text-center">
      <a href={base}>
        <div class="row">
          <div class="col-3">
            <img
              src={`${base}images/norway-grants.svg`}
              width="50"
              alt="BORDERSCAPE"
              class="img-fluid mt-3"
            />
          </div>
          <div class="col-9">
            <img
              src={`${base}images/borderscape.svg`}
              width="250"
              alt="BORDERSCAPE"
              class="img-fluid"
            />
          </div>
        </div>
      </a>
      <div class="lead ms-4">
        <strong>WebGIS</strong> State Formation and Settlement Patterns in the
        Ancient Egyptian Southern Border, 4th-3rd millennia BCE
      </div>
    </div>
  </div>
</header>
