---
const base = import.meta.env.BASE_URL;

const sponsors = [
  { href: "https://eeagrants.org/", title: "Norway Grants", src: "norway-grants.svg", alt: "Norway Grants", width: 100 },
  { href: "https://www.ncn.gov.pl/", title: "Narodowe Centrum Nauki", src: "ncn.svg", alt: "Narodowe Centrum Nauki", width: 150 },
  { href: "https://ncn.gov.pl/en/ogloszenia/konkursy/pols", title: "POLS (The POLS call is part of the Basic Research Programme operated by the National Science Centre under the EEA and Norway Grants and is prepared in cooperation with the Research Council of Norway)", src: "pols.svg", alt: "POLS", width: 80 },
  { href: "http://iksiopan.pl/index.php/pl/", title: "IKSIO PAN (Instytut Kultur Śródziemnomorskich i Orientalnych Polskiej Akademii Nauk)", src: "iksiopan.svg", alt: "IKSIO PAN", width: 150 },
  { href: "https://pan.pl/", title: "PAN (Polska Akademia Nauk)", src: "pan.svg", alt: "PAN", width: 100 },
  { href: "https://www.dlr.de/en/", title: "Deutsches Zentrum für Luft- und Raumfahrt", src: "dlr.svg", alt: "DLR", width: 200 },
  { href: "https://www.akapegypt.org/", title: "AKAP", src: "akap.svg", alt: "AKAP", width: 90 },
  { href: "https://lad.saras.uniroma1.it", title: "sCMS by LAD", src: "lad.svg", alt: "sCMS by LAD", width: 100 },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="d-flex flex-row justify-content-around align-items-center flex-wrap">
      {sponsors.map((s) => (
        <div>
          <a href={s.href} target="_blank" rel="noreferrer noopener" title={s.title}>
            <img src={`${base}images/${s.src}`} alt={s.alt} width={s.width} class="img-fluid" />
          </a>
        </div>
      ))}
    </div>

    <div class="text-center mt-3 pt-3 border-top">
      <p class="p-s-3">
        <strong>BORDERSCAPE</strong>
        <br />
        WebGIS of Egyptian State Formation and the Changing Socio-Spatial
        Landscape of the Nile First Cataract Region in the 4th and 3rd
        millennia BCE
      </p>
      <p class="my-1">
        The BORDERSCAPE Project received funding from the Norwegian Financial
        Mechanism 2014-2021 (grant no. POLS 2020/37/K/HS3/04097).
      </p>
    </div>

    <div class="text-center border-top mt-3 pt-3">
      <a href="https://zenodo.org/records/10775678" target="_blank" rel="noopener noreferrer">
        <img style="width: 150px" src="https://about.zenodo.org/static/img/logos/zenodo-gradient-200.png" alt="Data preserved in Zenodo" />
        <br />
        All research data are preserved in Zenodo with Creative Commons Attribution
        4.0 International License
        <br />
        <img src="https://zenodo.org/badge/DOI/10.5281/zenodo.10775678.svg" alt="10.5281/zenodo.10775678" />
      </a>
    </div>

    <div class="text-center mt-3 pt-3 border-top">
      <p class="p-s-3">
        This site has been built with <span class="heart">♥</span> by{" "}
        <a
          href="https://purl.org/lad"
          target="_blank"
          rel="noreferrer noopener"
          title="LAD: Laboratorio di Archeologia Digitale alla Sapienza"
        >
          LAD @Sapienza
        </a>
      </p>
    </div>
  </div>
</footer>
